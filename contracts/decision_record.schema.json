{
  "$defs": {
    "Allocation": {
      "additionalProperties": false,
      "properties": {
        "selected": {
          "description": "Whether this intervention was selected within attention and grid budget",
          "title": "Selected",
          "type": "boolean"
        },
        "shadow_price": {
          "description": "Marginal value shadow price at the budget cutoff",
          "title": "Shadow Price",
          "type": "number"
        },
        "slot": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Allocated staggered charging slot start time",
          "title": "Slot"
        }
      },
      "required": [
        "selected",
        "shadow_price"
      ],
      "title": "Allocation",
      "type": "object"
    },
    "BatteryView": {
      "additionalProperties": false,
      "properties": {
        "stress_score": {
          "description": "Relative battery stress score between 0.0 and 1.0",
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Stress Score",
          "type": "number"
        },
        "soh_delta_range_pct": {
          "description": "Simulated relative SOH difference range percentage vs default plan",
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "Soh Delta Range Pct",
          "type": "array"
        }
      },
      "required": [
        "stress_score",
        "soh_delta_range_pct"
      ],
      "title": "BatteryView",
      "type": "object"
    },
    "GridView": {
      "additionalProperties": false,
      "properties": {
        "stress_q50": {
          "description": "Median grid stress ratio (load / capacity)",
          "minimum": 0.0,
          "title": "Stress Q50",
          "type": "number"
        },
        "stress_q90": {
          "description": "90th percentile grid stress ratio",
          "minimum": 0.0,
          "title": "Stress Q90",
          "type": "number"
        },
        "green_window_start": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Start ISO timestamp or time for green charging window",
          "title": "Green Window Start"
        },
        "green_window_end": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "End ISO timestamp or time for green charging window",
          "title": "Green Window End"
        }
      },
      "required": [
        "stress_q50",
        "stress_q90"
      ],
      "title": "GridView",
      "type": "object"
    },
    "Journey": {
      "additionalProperties": false,
      "properties": {
        "p_arrive_above_reserve": {
          "description": "Calibrated probability of arriving at or above reserve SOC",
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "P Arrive Above Reserve",
          "type": "number"
        },
        "arrival_soc_q10": {
          "description": "10th percentile arrival SOC",
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Arrival Soc Q10",
          "type": "number"
        },
        "arrival_soc_q50": {
          "description": "Median arrival SOC",
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Arrival Soc Q50",
          "type": "number"
        },
        "arrival_soc_q90": {
          "description": "90th percentile arrival SOC",
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Arrival Soc Q90",
          "type": "number"
        },
        "reserve_soc": {
          "default": 0.1,
          "description": "Configured reserve SOC threshold",
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Reserve Soc",
          "type": "number"
        }
      },
      "required": [
        "p_arrive_above_reserve",
        "arrival_soc_q10",
        "arrival_soc_q50",
        "arrival_soc_q90"
      ],
      "title": "Journey",
      "type": "object"
    },
    "Language": {
      "additionalProperties": false,
      "properties": {
        "message": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Delivered message text (None if no nudge)",
          "title": "Message"
        },
        "facts_used": {
          "additionalProperties": true,
          "description": "Structured facts provided to and verified against the message",
          "title": "Facts Used",
          "type": "object"
        },
        "verified": {
          "default": false,
          "description": "Whether all numeric claims were verified against approved facts",
          "title": "Verified",
          "type": "boolean"
        },
        "source": {
          "default": "none",
          "description": "Message generation origin: llm, template, or none",
          "enum": [
            "llm",
            "template",
            "none"
          ],
          "title": "Source",
          "type": "string"
        }
      },
      "title": "Language",
      "type": "object"
    },
    "Outcome": {
      "additionalProperties": false,
      "properties": {
        "adopted": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Whether user adopted the nudged behavior",
          "title": "Adopted"
        },
        "kwh_shifted": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Observed energy shifted out of peak in kWh",
          "title": "Kwh Shifted"
        },
        "opted_out": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Whether user opted out after the message",
          "title": "Opted Out"
        },
        "reward": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Realized causal reward value",
          "title": "Reward"
        }
      },
      "title": "Outcome",
      "type": "object"
    },
    "Persuasion": {
      "additionalProperties": false,
      "properties": {
        "chosen_plan": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Chosen plan_id from safe plans, or None for 'none' action",
          "title": "Chosen Plan"
        },
        "frame": {
          "description": "Persuasion frame chosen by contextual bandit",
          "enum": [
            "none",
            "cost",
            "green",
            "battery",
            "convenience",
            "reassurance"
          ],
          "title": "Frame",
          "type": "string"
        },
        "timing": {
          "anyOf": [
            {
              "enum": [
                "at_plug_in",
                "plus_30m",
                "pre_peak"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Timing of notification delivery",
          "title": "Timing"
        },
        "uplift_mean": {
          "description": "Estimated expected uplift in adoption probability",
          "title": "Uplift Mean",
          "type": "number"
        },
        "uplift_p10": {
          "description": "Conservative 10th percentile uplift estimate",
          "title": "Uplift P10",
          "type": "number"
        },
        "propensity": {
          "description": "Action selection propensity P(a|x) logged for off-policy evaluation",
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Propensity",
          "type": "number"
        },
        "explored": {
          "description": "Whether this action was chosen as an exploratory step",
          "title": "Explored",
          "type": "boolean"
        }
      },
      "required": [
        "frame",
        "uplift_mean",
        "uplift_p10",
        "propensity",
        "explored"
      ],
      "title": "Persuasion",
      "type": "object"
    },
    "Plan": {
      "additionalProperties": false,
      "properties": {
        "plan_id": {
          "description": "Unique plan identifier",
          "title": "Plan Id",
          "type": "string"
        },
        "type": {
          "description": "Charging plan type",
          "enum": [
            "default",
            "delay",
            "relocate",
            "slow_charge",
            "top_up_now"
          ],
          "title": "Type",
          "type": "string"
        },
        "start": {
          "description": "ISO 8601 start time",
          "title": "Start",
          "type": "string"
        },
        "kw": {
          "description": "Charging power in kW",
          "minimum": 0.0,
          "title": "Kw",
          "type": "number"
        },
        "where": {
          "description": "Location: 'home' or station_id",
          "title": "Where",
          "type": "string"
        },
        "outcomes": {
          "additionalProperties": true,
          "description": "Predicted plan outcomes: cost_inr, journey_conf_lb, grid_value, battery_stress_delta, wait_min",
          "title": "Outcomes",
          "type": "object"
        }
      },
      "required": [
        "plan_id",
        "type",
        "start",
        "kw",
        "where",
        "outcomes"
      ],
      "title": "Plan",
      "type": "object"
    },
    "Safety": {
      "additionalProperties": false,
      "properties": {
        "invariants_ok": {
          "description": "Whether all Python safety invariants passed",
          "title": "Invariants Ok",
          "type": "boolean"
        },
        "cedar": {
          "description": "AWS Cedar policy evaluation verdict",
          "enum": [
            "ALLOW",
            "DENY",
            "ERROR"
          ],
          "title": "Cedar",
          "type": "string"
        },
        "vetoed": {
          "description": "Human-readable reasons for vetoed candidate plans",
          "items": {
            "type": "string"
          },
          "title": "Vetoed",
          "type": "array"
        }
      },
      "required": [
        "invariants_ok",
        "cedar"
      ],
      "title": "Safety",
      "type": "object"
    },
    "StationView": {
      "additionalProperties": false,
      "properties": {
        "eta_wait_min_q50": {
          "description": "Median estimated wait in minutes at user ETA",
          "minimum": 0.0,
          "title": "Eta Wait Min Q50",
          "type": "number"
        },
        "eta_wait_min_q90": {
          "description": "90th percentile estimated wait in minutes at user ETA",
          "minimum": 0.0,
          "title": "Eta Wait Min Q90",
          "type": "number"
        },
        "reliability": {
          "description": "Assumed station operational reliability in simulation",
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Reliability",
          "type": "number"
        }
      },
      "required": [
        "eta_wait_min_q50",
        "eta_wait_min_q90",
        "reliability"
      ],
      "title": "StationView",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "decision_id": {
      "description": "Unique decision UUID or ID",
      "title": "Decision Id",
      "type": "string"
    },
    "run_id": {
      "description": "Simulation or operational run ID",
      "title": "Run Id",
      "type": "string"
    },
    "sim_time": {
      "description": "ISO 8601 simulation timestamp",
      "title": "Sim Time",
      "type": "string"
    },
    "user_id": {
      "description": "Identifier for EV user / driver",
      "title": "User Id",
      "type": "string"
    },
    "ev": {
      "additionalProperties": true,
      "description": "EV specifications (battery_kwh, current_soc, max_kw, etc.)",
      "title": "Ev",
      "type": "object"
    },
    "journey": {
      "anyOf": [
        {
          "$ref": "#/$defs/Journey"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Journey confidence perception output"
    },
    "battery": {
      "anyOf": [
        {
          "$ref": "#/$defs/BatteryView"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Battery stress perception output"
    },
    "station": {
      "anyOf": [
        {
          "$ref": "#/$defs/StationView"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Station wait and reliability perception output"
    },
    "grid": {
      "anyOf": [
        {
          "$ref": "#/$defs/GridView"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Grid stress and green window perception output"
    },
    "plans": {
      "description": "Enumerated candidate charging plans",
      "items": {
        "$ref": "#/$defs/Plan"
      },
      "title": "Plans",
      "type": "array"
    },
    "safety": {
      "$ref": "#/$defs/Safety",
      "description": "Safety gating verification record"
    },
    "persuasion": {
      "$ref": "#/$defs/Persuasion",
      "description": "Bandit persuasion decision and uplift"
    },
    "allocation": {
      "$ref": "#/$defs/Allocation",
      "description": "Fleet allocation decision"
    },
    "language": {
      "$ref": "#/$defs/Language",
      "description": "Message generation and verification record"
    },
    "outcome": {
      "$ref": "#/$defs/Outcome",
      "description": "Realized outcome from simulator or telematics"
    },
    "fail_silent": {
      "default": false,
      "description": "True if an error caused graceful fallback to silence",
      "title": "Fail Silent",
      "type": "boolean"
    },
    "error": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Error details if fail_silent triggered",
      "title": "Error"
    }
  },
  "required": [
    "decision_id",
    "run_id",
    "sim_time",
    "user_id",
    "ev",
    "safety",
    "persuasion",
    "allocation"
  ],
  "title": "DecisionRecord",
  "type": "object"
}